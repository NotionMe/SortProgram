<Window
    x:Class="Practika2_OPAM_Ubohyi_Stanislav.Notates.Notate"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="600"
    Height="600"
    Background="Transparent"
    CanResize="False"
    SystemDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Border Background="#F9F9F9" CornerRadius="15">
            <Border.BoxShadow>
                <BoxShadows>0 0 15 5 #E0E0E0</BoxShadows>
            </Border.BoxShadow>
            <DockPanel Margin="20">
                <StackPanel
                    Margin="0,0,0,15"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ComboBox
                        x:Name="SortComboBox"
                        Height="45"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#FFFFFF"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        FontSize="18"
                        Foreground="#333333"
                        SelectedIndex="1"
                        SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Bubble Sort" />
                        <ComboBoxItem Content="Selection Sort" />
                        <ComboBoxItem Content="Quick Sort" />
                        <ComboBoxItem Content="Insertion Sort" />
                        <ComboBoxItem Content="Merge Sort" />
                        <ComboBoxItem Content="Heap Sort" />
                        <ComboBoxItem Content="Radix Sort" />
                        <ComboBoxItem Content="Linear Search" />
                        <ComboBoxItem Content="Binary Search" />
                        <ComboBoxItem Content="Jump Search" />
                        <ComboBoxItem Content="Breadth-First Search" />
                        <ComboBoxItem Content="Depth-First Search" />
                        <ComboBoxItem Content="Dijkstra's Algorithm" />

                    </ComboBox>
                    <Label
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="Notate"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="#222222" />
                </StackPanel>

                <Button
                    x:Name="SaveButton"
                    Height="50"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#007AFF"
                    Click="SaveButton_Click"
                    Content="Save Note"
                    CornerRadius="8"
                    DockPanel.Dock="Bottom"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="#FFFFFF">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#005FCC" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0.2" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="#004C99" />
                        </Style>
                    </Button.Styles>
                </Button>

                <TextBox
                    x:Name="NoteTextBox"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Width="520"
                    Height="400"
                    VerticalContentAlignment="Top"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Background="#FFFFFF"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8"
                    FontSize="18"
                    Foreground="#333333"
                    Watermark="Enter your note here..."
                    TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
