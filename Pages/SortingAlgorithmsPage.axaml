<UserControl
    x:Class="Practika2_OPAM_Ubohyi_Stanislav.Pages.SortingAlgorithmsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:anim="using:AnimatedImage.Avalonia"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel>
            <!-- Search Box at the top -->
                <Border
                x:Name="SearchControl"
                Width="600"
                Height="55"
                Margin="0,10,0,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#555555">
                <Grid>
                    <AutoCompleteBox 
                    Classes="searchBox"
                    x:Name="Algoritm" 
                    FilterMode="Contains"
                    Width="590"
                    Height="50"
                    Watermark="Search🔍"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    TextChanged="Algoritm_TextChanged"
                    />
                </Grid>
                </Border>

            <StackPanel x:Name="AlgorithmsContainer" Margin="30">
                <Border
                    Margin="0,10,0,20"
                    BoxShadow="0 4 8 #20000000"
                    Classes="fluentCard"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="20,15,10,15"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="{StaticResource OswaldFont}"
                                FontSize="36"
                                FontWeight="SemiBold"
                                Text="{DynamicResource BubbleSort_Name}" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Text="{DynamicResource BubbleSort_Description}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Width="120"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="blueButton"
                                    Click="InfoBubbleSort_Click"
                                    Content="{DynamicResource Button_LearnMore}"
                                    CornerRadius="5" />
                                <Button
                                    Width="170"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="successButton"
                                    Click="BubbleSortPage_Click"
                                    Content="{DynamicResource Button_TryIt}"
                                    CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="400"
                            Height="125"
                            Margin="10,15,20,15"
                            BoxShadow="0 2 4 #20000000"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/bubble_sort.gif" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
                <Border
                    Margin="0,10,0,20"
                    BoxShadow="0 4 8 #20000000"
                    Classes="fluentCard"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="20,15,10,15"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="{StaticResource OswaldFont}"
                                FontSize="36"
                                FontWeight="SemiBold"
                                Text="{DynamicResource SelectionSort_Name}" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Text="{DynamicResource SelectionSort_Description}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Width="120"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="blueButton"
                                    Click="InfoSelectionSort_Click"
                                    Content="{DynamicResource Button_LearnMore}"
                                    CornerRadius="5" />
                                <Button
                                    Width="170"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="successButton"
                                    Click="SelectionSortPage_Click"
                                    Content="{DynamicResource Button_TryIt}"
                                    CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="400"
                            Height="125"
                            Margin="10,15,20,15"
                            BoxShadow="0 2 4 #20000000"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/selection_sort.gif" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
                <Border
                    Margin="0,10,0,20"
                    BoxShadow="0 4 8 #20000000"
                    Classes="fluentCard"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="20,15,10,15"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="{StaticResource OswaldFont}"
                                FontSize="36"
                                FontWeight="SemiBold"
                                Text="{DynamicResource QuickSort_Name}" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Text="{DynamicResource QuickSort_Description}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Width="120"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="blueButton"
                                    Click="InfoQuickSort_Click"
                                    Content="{DynamicResource Button_LearnMore}"
                                    CornerRadius="5" />
                                <Button
                                    Width="170"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="successButton"
                                    Click="QuickSortPage_Click"
                                    Content="{DynamicResource Button_TryIt}"
                                    CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="400"
                            Height="125"
                            Margin="10,15,20,15"
                            BoxShadow="0 2 4 #20000000"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/quick_sort.gif" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
                <Border
                    Margin="0,10,0,20"
                    BoxShadow="0 4 8 #20000000"
                    Classes="fluentCard"
                    CornerRadius="10">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel
                            Grid.Column="0"
                            Margin="20,15,10,15"
                            VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontFamily="{StaticResource OswaldFont}"
                                FontSize="36"
                                FontWeight="SemiBold"
                                Text="{DynamicResource InsertionSort_Name}" />
                            <TextBlock
                                Margin="0,0,0,10"
                                Text="{DynamicResource InsertionSort_Description}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    Width="120"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="blueButton"
                                    Click="InfoInsertionSort_Click"
                                    Content="{DynamicResource Button_LearnMore}"
                                    CornerRadius="5" />
                                <Button
                                    Width="170"
                                    Margin="0,10,0,0"
                                    Padding="12,8"
                                    HorizontalAlignment="Left"
                                    Classes="successButton"
                                    Click="InsertionSortPage_Click"
                                    Content="{DynamicResource Button_TryIt}"
                                    CornerRadius="5" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="400"
                            Height="125"
                            Margin="10,15,20,15"
                            BoxShadow="0 2 4 #20000000"
                            ClipToBounds="True"
                            CornerRadius="5">
                            <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/insertion_sort.gif" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
