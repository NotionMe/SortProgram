                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoJumpSearch_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
                                Click="JumpSearchPage_Click"
                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/JumpSearch.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- BFS -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_BFS_Graph_Traversal_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource BFS_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoBFS_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
                                Click="BFSPage_Click"
                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/BFS.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- Depth-First Search -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_DFS_Graph_Traversal_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource DFS_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoDFS_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
