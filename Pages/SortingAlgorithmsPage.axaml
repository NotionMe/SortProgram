                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/DFS.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- Dijkstra's Algorithm -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_Dijkstras_Algorithm_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource Dijkstras_Algorithm_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoDijkstras_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
                                Click="DijkstrasPage_Click"
                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/Dijkstra_Algorithm.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- Inorder Traversal -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_Inorder_Traversal_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource Inorder_Traversal_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoInorder_Traversal_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
                                Click="Inorder_TraversalPage_Click"
                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/Inorder_Traversal.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- Preorder Traversal -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_Preorder_Traversal_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource Preorder_Traversal_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoPreorder_Traversal_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="successButton"
                                Click="Preorder_TraversalPage_Click"
                                Content="{DynamicResource Button_TryIt}"
                                CornerRadius="5" />
                        </StackPanel>
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Height="150"
                        Margin="10,15,20,15"
                        BoxShadow="0 2 4 #20000000"
                        ClipToBounds="False"
                        CornerRadius="5">
                        <Image anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/Preorder_Traversal.gif" Stretch="Fill" />
                    </Border>
                </Grid>
            </Border>
            <!-- Postorder Traversal -->
            <Border
                Margin="0,10,0,20"
                BoxShadow="0 4 8 #20000000"
                Classes="fluentCard"
                CornerRadius="10">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel
                        Grid.Column="0"
                        Margin="20,15,10,15"
                        VerticalAlignment="Center">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontFamily="{StaticResource OswaldFont}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            Text="{DynamicResource InfoPage_Postorder_Traversal_Title}" />
                        <TextBlock
                            Margin="0,0,0,10"
                            Text="{DynamicResource Postorder_Traversal_Description}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                Width="180"
                                Margin="0,10,0,0"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Classes="blueButton"
                                Click="InfoPostorder_Traversal_Click"
                                Content="{DynamicResource Button_LearnMore}"
                                CornerRadius="5" />
                            <Button
                                Width="170"
                                Margin="0,10,0,0"
