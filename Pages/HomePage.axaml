<UserControl
    x:Class="Practika2_OPAM_Ubohyi_Stanislav.Pages.HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:AnimatedImage.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Practika2_OPAM_Ubohyi_Stanislav.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Practika2_OPAM_Ubohyi_Stanislav.ViewModels"
    x:DataType="vm:HomePageViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:HomePageViewModel />
    </Design.DataContext>

    <Grid>
        <StackPanel Margin="20" Spacing="20">
            <Border
                Width="1060"
                Height="161"
                Margin="0,0,0,10"
                Padding="20"
                BoxShadow="0 0 14.1 4 #40000000"
                Classes="card"
                CornerRadius="10">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource OswaldFont}"
                    FontSize="48"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ThemeForegroundBrush}"
                    Text="{Binding LanguageManager[HomePage_Title]}" />
            </Border>
            <Grid
                Margin="0,10"
                ColumnDefinitions="*,*,*,*"
                RowDefinitions="Auto,Auto,Auto">
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="220"
                    Height="45"
                    Margin="0,0,5,10"
                    HorizontalAlignment="Center"
                    Background="#0C294B"
                    BorderThickness="2"
                    CornerRadius="20">
                    <TextBlock
                        Margin="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding LanguageManager[BubbleSort_Name]}" />
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="220"
                    Height="45"
                    Margin="5,0,5,10"
                    HorizontalAlignment="Center"
                    Background="#0C294B"
                    BorderThickness="2"
                    CornerRadius="20">
                    <TextBlock
                        Margin="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding LanguageManager[SelectionSort_Name]}" />
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="220"
                    Height="45"
                    Margin="5,0,5,10"
                    HorizontalAlignment="Center"
                    Background="#0C294B"
                    BorderThickness="2"
                    CornerRadius="20">
                    <TextBlock
                        Margin="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding LanguageManager[QuickSort_Name]}" />
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="3"
                    Width="220"
                    Height="45"
                    Margin="5,0,0,10"
                    HorizontalAlignment="Center"
                    Background="#0C294B"
                    BorderThickness="2"
                    CornerRadius="20">
                    <TextBlock
                        Margin="10,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding LanguageManager[InsertionSort_Name]}" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Width="220"
                    Height="150"
                    Margin="0,15,5,15"
                    Classes="card"
                    CornerRadius="8">
                    <Image
                        Name="BubbleSortImage"
                        Margin="5"
                        anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/bubble_sort.gif"
                        Stretch="Uniform" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="220"
                    Height="150"
                    Margin="5,15,5,15"
                    Classes="card"
                    CornerRadius="8">
                    <Image
                        Name="SelectionSortImage"
                        Margin="5"
                        anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/selection_sort.gif"
                        Stretch="Uniform" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Width="220"
                    Height="150"
                    Margin="5,15,5,15"
                    Classes="card"
                    CornerRadius="8">
                    <Image
                        Name="QuickSortImage"
                        Margin="5"
                        anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/quick_sort.gif"
                        Stretch="Uniform" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="3"
                    Width="220"
                    Height="150"
                    Margin="5,15,0,15"
                    Classes="card"
                    CornerRadius="8">
                    <Image
                        Name="InsertionSortImage"
                        Margin="5"
                        anim:ImageBehavior.AnimatedSource="avares://Practika2_OPAM_Ubohyi_Stanislav/Assets/Images/Animation/insertion_sort.gif"
                        Stretch="Uniform" />
                </Border>
                <!--  Algorithm Descriptions  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Width="220"
                    MinHeight="220"
                    Margin="0,5,5,15"
                    BoxShadow="0 4 4 #40000000"
                    Classes="card"
                    CornerRadius="8">
                    <TextBlock
                        Margin="10"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ThemeForegroundBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run
                            Classes="description-title"
                            FontSize="16"
                            Text="{Binding LanguageManager[BubbleSort_Name]}" />
                        <LineBreak />
                        <Run Text="{Binding LanguageManager[BubbleSort_Description]}" />
                    </TextBlock>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="220"
                    MinHeight="220"
                    Margin="5,5,5,15"
                    BoxShadow="0 4 4 #40000000"
                    Classes="card"
                    CornerRadius="8">
                    <TextBlock
                        Margin="10"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ThemeForegroundBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap">
                        <Run
                            Classes="description-title"
                            FontSize="16"
                            Text="{Binding LanguageManager[SelectionSort_Name]}" />
                        <LineBreak />
                        <Run Text="{Binding LanguageManager[SelectionSort_Description]}" />
                    </TextBlock>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="220"
                    MinHeight="220"
                    Margin="5,5,5,15"
                    BoxShadow="0 4 4 #40000000"
                    Classes="card"
                    CornerRadius="8">
                    <TextBlock
                        Margin="10"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ThemeForegroundBrush}"
                        TextAlignment="Center"
                        TextTrimming="None"
                        TextWrapping="Wrap">
                        <Run
                            Classes="description-title"
                            FontSize="16"
                            Text="{Binding LanguageManager[QuickSort_Name]}" />
                        <LineBreak />
                        <Run Text="{Binding LanguageManager[QuickSort_Description]}" />
                    </TextBlock>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.Column="3"
                    Width="220"
                    MinHeight="220"
                    Margin="5,5,0,15"
                    BoxShadow="0 4 4 #40000000"
                    Classes="card"
                    CornerRadius="8">
                    <TextBlock
                        Margin="10"
                        FontFamily="Inter"
                        FontSize="14"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Foreground="{DynamicResource ThemeForegroundBrush}"
                        TextAlignment="Center"
                        TextTrimming="None"
                        TextWrapping="Wrap">
                        <Run
                            Classes="description-title"
                            FontSize="16"
                            Text="{Binding LanguageManager[InsertionSort_Name]}" />
                        <LineBreak />
                        <Run Text="{Binding LanguageManager[InsertionSort_Description]}" />
                    </TextBlock>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
