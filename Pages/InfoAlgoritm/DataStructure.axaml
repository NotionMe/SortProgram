<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Practika2_OPAM_Ubohyi_Stanislav.Pages.InfoAlgoritm.DataStructure">
    
    <UserControl.Styles>
        <Style Selector="Border.header">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="{DynamicResource AccentColor}"/>
                    <GradientStop Offset="1" Color="{DynamicResource PrimaryColor}"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 2 10 1 #40000000"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="Border.fluentCard">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #30000000"/>
        </Style>
        
        <Style Selector="TextBlock.structure-title">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="2" Opacity="0.6" OffsetX="1" OffsetY="1"/>
            </Setter>
        </Style>
        
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        
        <Style Selector="Border.dataStructureBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BoxShadow" Value="0 2 5 0 #30000000"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Заголовок сторінки -->
        <Border Grid.Row="0" 
                Classes="header"
                Padding="18" 
                Margin="0,0,0,20">            <TextBlock Text="{DynamicResource DataStructure_PageTitle}" 
                       Classes="structure-title"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Основний вміст сторінки -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Margin="15">
                <!-- Основна інформація про структури даних -->
                <Border Classes="fluentCard">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource DataStructure_Definition_Title}"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,10">
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource AccentBrush}" 
                                    Width="5" 
                                    CornerRadius="2"
                                    Margin="0,0,10,0"/>                            <TextBlock Grid.Column="1" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,10"
                                       Text="{DynamicResource DataStructure_Definition_Text}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Основні структури даних -->
                <Border Classes="fluentCard">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource DataStructure_BasicTypes_Title}"/>
                          <!-- Масиви -->
                        <Border Classes="dataStructureBox">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Text="{DynamicResource DataStructure_Array_Title}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DataStructure_Array_Description}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_Array_Advantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_Array_Advantages_List}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_Array_Disadvantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_Array_Disadvantages_List}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                          <!-- Зв'язані списки -->
                        <Border Classes="dataStructureBox">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AccentBrush}" Text="{DynamicResource DataStructure_LinkedList_Title}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DataStructure_LinkedList_Description}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_LinkedList_Advantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_LinkedList_Advantages_List}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_LinkedList_Disadvantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_LinkedList_Disadvantages_List}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                          <!-- Стеки та черги -->
                        <Border Classes="dataStructureBox">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource InfoBrush}" Text="{DynamicResource DataStructure_StackQueue_Title}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DataStructure_StackQueue_Description}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_StackQueue_Applications}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_StackQueue_Applications_List}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                          <!-- Дерева -->
                        <Border Classes="dataStructureBox">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource SuccessBrush}" Text="{DynamicResource DataStructure_Tree_Title}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DataStructure_Tree_Description}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_Tree_Advantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_Tree_Advantages_List}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                          <!-- Хеш-таблиці -->
                        <Border Classes="dataStructureBox" Margin="0">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource WarningBrush}" Text="{DynamicResource DataStructure_HashTable_Title}" Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DataStructure_HashTable_Description}"/>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_HashTable_Advantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_HashTable_Advantages_List}"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource DataStructure_HashTable_Disadvantages}" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{DynamicResource DataStructure_HashTable_Disadvantages_List}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Зв'язок алгоритмів та структур даних -->
                <Border Classes="fluentCard">
                    <StackPanel>                        <TextBlock Classes="sectionTitle" Text="{DynamicResource DataStructure_AlgorithmRelation_Title}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                                   Text="{DynamicResource DataStructure_AlgorithmRelation_Text}"/>                        <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
                            <Border Grid.Column="0" Classes="dataStructureBox" Margin="0,0,7.5,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{DynamicResource DataStructure_Algorithm_Sorting}" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="{DynamicResource DataStructure_Algorithm_Sorting_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Classes="dataStructureBox" Margin="7.5,0,0,0">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="{DynamicResource DataStructure_Algorithm_Search}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="{DynamicResource DataStructure_Algorithm_Search_Desc}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Кнопки навігації -->
                <Border Classes="fluentCard" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Content="{DynamicResource BackToHome_Button}"
                                HorizontalAlignment="Center"
                                Padding="20,10"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                CornerRadius="20"
                                Click="BackToHome_Click"/>
                        
                        <Button Grid.Column="1"
                                Content="{DynamicResource BackToAlgorithm_Button}"
                                HorizontalAlignment="Center"
                                Padding="20,10"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                CornerRadius="20"
                                Click="InfoAlgoritm_Clock"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
