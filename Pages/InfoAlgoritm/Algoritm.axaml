<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Practika2_OPAM_Ubohyi_Stanislav.Pages.InfoAlgoritm.Algoritm">
    
    <UserControl.Styles>
        <Style Selector="Border.header">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="{DynamicResource PrimaryColor}"/>
                    <GradientStop Offset="1" Color="{DynamicResource AccentColor}"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BoxShadow" Value="0 2 10 1 #40000000"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="Border.fluentCard">
            <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #30000000"/>
        </Style>
        
        <Style Selector="Border.fluentCard">
            <Setter Property="BoxShadow" Value="0 5 15 0 #40000000"/>
        </Style>
        
        <Style Selector="TextBlock.algorithm-title">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="2" Opacity="0.6" OffsetX="1" OffsetY="1"/>
            </Setter>
        </Style>
        
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 1 3 0 #20000000"/>
        </Style>
        
        <Style Selector="Border.panel">
            <Setter Property="BoxShadow" Value="0 3 6 0 #30000000"/>
        </Style>
        
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        <!-- Заголовок сторінки -->
        <Border Grid.Row="0" 
                Classes="header"
                Padding="18" 
                Margin="0,0,0,20">            <TextBlock Text="{DynamicResource Algorithm_Title}" 
                       Classes="algorithm-title"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основний вміст сторінки -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Margin="15">
                <!-- Основна інформація про алгоритми -->
                <Border Classes="fluentCard">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource Algorithm_Definition_Title}"/>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,10">
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource PrimaryBrush}" 
                                    Width="5" 
                                    CornerRadius="2"
                                    Margin="0,0,10,0"/>                            <TextBlock Grid.Column="1" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,10"
                                       Text="{DynamicResource Algorithm_Definition_Text}"/>
                        </Grid>
                        
                        <Border BorderBrush="{DynamicResource AccentBrush}" 
                                BorderThickness="0,0,0,1" 
                                Padding="0,0,0,10" 
                                Margin="0,0,0,10">                            <TextBlock TextWrapping="Wrap" 
                                       Opacity="0.9" 
                                       FontStyle="Italic"
                                       Text="{DynamicResource Algorithm_Origin}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Основні властивості алгоритмів -->
                <Border Classes="fluentCard">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="{DynamicResource Algorithm_Properties_Title}"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                            <!-- Дискретність -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,15,20" 
                                   Background="{DynamicResource PrimaryBrush}"
                                   CornerRadius="6" Width="10" Height="35"
                                   BoxShadow="0 1 3 0 #30000000"/>
                            <Border Grid.Row="0" Grid.Column="1" 
                                    Classes="panel"
                                    Background="#05000000"
                                    Margin="0,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" 
                                               Foreground="{DynamicResource PrimaryBrush}" 
                                               Text="{DynamicResource Algorithm_Property_Discreteness}" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{DynamicResource Algorithm_Property_Discreteness_Desc}"/>
                                </StackPanel>
                            </Border>

                            <!-- Детермінованість -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,15,20" 
                                   Background="{DynamicResource AccentBrush}"
                                   CornerRadius="6" Width="10" Height="35"
                                   BoxShadow="0 1 3 0 #30000000"/>
                            <Border Grid.Row="1" Grid.Column="1" 
                                    Classes="panel"
                                    Background="#05000000"
                                    Margin="0,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBrush}" 
                                               Text="{DynamicResource Algorithm_Property_Determinism}" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{DynamicResource Algorithm_Property_Determinism_Desc}"/>
                                </StackPanel>
                            </Border>

                            <!-- Кінцевість -->
                            <Border Grid.Row="2" Grid.Column="0" Margin="0,0,15,20" 
                                   Background="{DynamicResource InfoBrush}"
                                   CornerRadius="6" Width="10" Height="35"
                                   BoxShadow="0 1 3 0 #30000000"/>
                            <Border Grid.Row="2" Grid.Column="1" 
                                    Classes="panel"
                                    Background="#05000000"
                                    Margin="0,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" 
                                               Foreground="{DynamicResource InfoBrush}" 
                                               Text="{DynamicResource Algorithm_Property_Finiteness}" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{DynamicResource Algorithm_Property_Finiteness_Desc}"/>
                                </StackPanel>
                            </Border>

                            <!-- Ефективність -->
                            <Border Grid.Row="3" Grid.Column="0" Margin="0,0,15,20" 
                                   Background="{DynamicResource SuccessBrush}"
                                   CornerRadius="6" Width="10" Height="35"
                                   BoxShadow="0 1 3 0 #30000000"/>
                            <Border Grid.Row="3" Grid.Column="1" 
                                    Classes="panel"
                                    Background="#05000000"
                                    Margin="0,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" 
                                               Foreground="{DynamicResource SuccessBrush}" 
                                               Text="{DynamicResource Algorithm_Property_Efficiency}" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{DynamicResource Algorithm_Property_Efficiency_Desc}"/>
                                </StackPanel>
                            </Border>

                            <!-- Масовість -->
                            <Border Grid.Row="4" Grid.Column="0" Margin="0,0,15,0" 
                                   Background="{DynamicResource WarningBrush}"
                                   CornerRadius="6" Width="10" Height="35"
                                   BoxShadow="0 1 3 0 #30000000"/>
                            <Border Grid.Row="4" Grid.Column="1" 
                                    Classes="panel"
                                    Background="#05000000">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" 
                                               Foreground="{DynamicResource WarningBrush}" 
                                               Text="{DynamicResource Algorithm_Property_Massiveness}" 
                                               Margin="0,0,0,5"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="{DynamicResource Algorithm_Property_Massiveness_Desc}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Класи алгоритмів -->
                <Border Classes="fluentCard">
                    <StackPanel>                        <TextBlock Classes="sectionTitle" Text="{DynamicResource Algorithm_Classification_Title}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,5,0,15"
                                   Text="{DynamicResource Algorithm_Classification_Intro}"/>

                        <!-- Панелі з типами алгоритмів -->
                        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,0,0,15"
                                BoxShadow="0 2 8 0 #20000000">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="7,7,0,0" 
                                        Padding="10,8">                                    <TextBlock FontWeight="SemiBold" 
                                               Foreground="White" 
                                               Text="{DynamicResource Algorithm_Implementation_Types}"/>
                                </Border>
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource ThemeControlMidBrush}"
                                        CornerRadius="0,0,7,7" 
                                        Padding="15,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource InfoBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Implementation_Recursive}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource InfoBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Implementation_Iterative}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource InfoBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Implementation_Parallel}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource InfoBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Implementation_Distributed}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Margin="0,0,0,15"
                                BoxShadow="0 2 8 0 #20000000">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="7,7,0,0" 
                                        Padding="10,8">                                    <TextBlock FontWeight="SemiBold" 
                                               Foreground="White" 
                                               Text="{DynamicResource Algorithm_Task_Types}"/>
                                </Border>
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource ThemeControlMidBrush}"
                                        CornerRadius="0,0,7,7" 
                                        Padding="15,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource PrimaryBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Task_Sorting}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource PrimaryBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Task_Search}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource PrimaryBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Task_Encryption}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource PrimaryBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Task_Graph}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource PrimaryBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Task_Combinatorial}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                BoxShadow="0 2 8 0 #20000000">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" 
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="7,7,0,0" 
                                        Padding="10,8">                                    <TextBlock FontWeight="SemiBold" 
                                               Foreground="White" 
                                               Text="{DynamicResource Algorithm_Complexity_Types}"/>
                                </Border>
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource ThemeControlMidBrush}"
                                        CornerRadius="0,0,7,7" 
                                        Padding="15,10">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,5,0,5">
                                        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_O1}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_LogN}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_N}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,5,0,5">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_NLogN}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_N2}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="10,5,0,0">
                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource AccentBrush}" 
                                                    Width="8" Height="8" 
                                                    CornerRadius="4" 
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="{DynamicResource Algorithm_Complexity_2N}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Застосування алгоритмів -->
                <Border Classes="fluentCard">
                    <StackPanel>                        <TextBlock Classes="sectionTitle" Text="{DynamicResource Algorithm_Applications_Title}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                                   Text="{DynamicResource Algorithm_Applications_Intro}"/>
                        <Grid Margin="0,10,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
                            <!-- Перший ряд -->
                            <Border Grid.Row="0" Grid.Column="0" Classes="panel" Margin="0,0,7.5,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_ComputerScience}" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource PrimaryBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_ComputerScience_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Row="0" Grid.Column="1" Classes="panel" Margin="7.5,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_Math}" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource AccentBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_Math_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Другий ряд -->
                            <Border Grid.Row="1" Grid.Column="0" Classes="panel" Margin="0,0,7.5,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_Biology}" Foreground="{DynamicResource SuccessBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource SuccessBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_Biology_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="1" Classes="panel" Margin="7.5,0,0,15">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_Economics}" Foreground="{DynamicResource WarningBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource WarningBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_Economics_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Третій ряд -->
                            <Border Grid.Row="2" Grid.Column="0" Classes="panel" Margin="0,0,7.5,0">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_Engineering}" Foreground="{DynamicResource InfoBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource InfoBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_Engineering_Desc}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Row="2" Grid.Column="1" Classes="panel" Margin="7.5,0,0,0">
                                <StackPanel>                                    <TextBlock FontWeight="Bold" Text="{DynamicResource Algorithm_Field_Medicine}" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <Border Margin="0,5,0,5" Height="1" Background="{DynamicResource PrimaryBrush}" Opacity="0.3"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12"
                                               Text="{DynamicResource Algorithm_Field_Medicine_Desc}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Навігаційні кнопки та інформаційні посилання -->
                <Border Classes="fluentCard" Margin="0,20,0,0">
                    <StackPanel Orientation="Vertical" Spacing="15">
                        <!-- Інформаційний блок про структури даних -->
                        <Border Background="{DynamicResource ThemeAccentBrush}" CornerRadius="8" Padding="15" 
                                BoxShadow="0 2 8 0 #30000000">
                            <StackPanel>                                <TextBlock Text="{DynamicResource DataStructure_Title}" 
                                           FontWeight="Bold" 
                                           FontSize="20" 
                                           Foreground="White"
                                           Margin="0,0,0,10"/>
                                <TextBlock TextWrapping="Wrap" 
                                           Foreground="White" 
                                           Opacity="0.9" 
                                           Margin="0,0,0,10"
                                           Text="{DynamicResource DataStructure_Description}"/>                                <Button Content="{DynamicResource DataStructure_Button}" 
                                        HorizontalAlignment="Right"
                                        Padding="15,8"
                                        Background="White"
                                        Foreground="{DynamicResource ThemeAccentBrush}"
                                        CornerRadius="20"
                                        Click="InfoDateStructureButton_Click"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Навігаційні кнопки -->
                        <Grid ColumnDefinitions="*,*" Margin="0,10,0,5">                            <Button Grid.Column="0"
                                    Content="{DynamicResource BackToHome_Button}"
                                    HorizontalAlignment="Left"
                                    Padding="20,10"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Foreground="White"
                                    CornerRadius="20"
                                    Click="BackToHome_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>